			"salesTerms": {
				"title": "Salgsbetingelser",
				"content": "Prisene er netto eks. mva. Leveringsbetingelser er ExW TESS iht Incoterms 2010 eller NL09."
			},
			"deliveries": {
				"title": "Forsendelser",
				"content": "For kundens regning."
			},
			"ownership": {
				"title": "Eiendomsrett",
				"content": "Selger har eiendomsretten til de solgte varene inntil kj\u00f8pesummen med tillegg av renter og omkostninger i sin helhet er betalt (kfr: Panteloven, spesielt \u00a73-15). Faktureringsgebyr: kr 65,- +mva."
			},
			"returns": {
				"title": "Retur av varer",
				"content": "Retur godkjennes etter avtale med din lokale TESS representant. Om du ikke er tilknyttet en lokal TESS-avdeling avtales retur med Kundesenteret p\u00e5 TESS hovedkontor. Se e-post og telefonnummer i bunnmeny. Kappede slanger, monterte enheter, utg\u00e5tte eller spesialproduserte produkter tas normalt ikke i retur. Med mindre annet er avtalt, dekker kj\u00f8per de direkte kostnadene ved \u00e5 returnere varen. Direkte kostnader vil v\u00e6re forsendelses- eller transportkostnader, og eventuelle andre direkte kostnader som eksempelvis innkj\u00f8p av ny frakt emballasje. Begrepet dekker ikke eventuelle administrative kostnader returen har for den n\u00e6ringsdrivende."
			},
			"payment": {
				"title": "Betaling med Visa eller Mastercard",
				"content": "N\u00e5r du har betalt med Visa eller Mastercard reserves hele kj\u00f8pesummen p\u00e5 kortet ved registrering av bestillingen, men belastes f\u00f8rst ved sending av varene. Dersom vi ikke kan levere en varelinje vil vi ikke trekke dette bel\u00f8pet fra kortet."
			},
			"disclaimer": {
				"title": "Forbehold",
				"content": "Det tas ytterligere forbehold for dokumenterbare endringer fra underleverand\u00f8rer, endrede r\u00e5varepriser, eventuelle valutasvingninger og trykkfeil. Legeringstillegg, r\u00e5varetillegg og eventuelle milj\u00f8avgifter kan forekomme for enkelte varegrupper."
			},
			"form": {
				"title": "Skjema",
				"content": "Angrerettskjema finner du <link>her</link>."
			}
